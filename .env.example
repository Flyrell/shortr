# Copy to .env: the docker compose development profile. The paths are container
# paths and the log level is louder than the production default (info).
PORT=8080
BASE_URL=http://localhost:8080
STATIC_DIR=/app/apps/client/dist
URL_TTL=30d
URL_PERSISTER=redis
RATE_LIMIT_MODE=day
RATE_LIMIT_VALUE=30
TRUSTED_PROXIES=
LOG_LEVEL=debug

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=devpassword
REDIS_DB=0
